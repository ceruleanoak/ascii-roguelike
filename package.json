{
  "name": "ascii-roguelike",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "enemy-editor": "vite --open /tools/enemy-editor/index.html",
    "check:arch": "node tools/check-architecture.js",
    "check:data": "node tools/check-data.js",
    "build": "npm run check:arch && npm run check:data && NODE_ENV=production vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist --no-history"
  },
  "devDependencies": {
    "gh-pages": "^6.1.1",
    "vite": "^5.0.0"
  }
}
